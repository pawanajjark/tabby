{
  "name": "tabby",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:instamart": "tsx watch server/instamart/httpServer.ts",
    "start:instamart": "tsx server/instamart/httpServer.ts",
    "mcp:instamart": "tsx server/instamart/mcpProxy.ts",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:instamart": "tsx --test tests/instamartRecipeAgent.test.ts tests/instamartChatAgent.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "dotenv": "^17.4.2",
    "openai": "^7.10.0",
    "spacetimedb": "2.10.*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "1.3.0"
  }
}
